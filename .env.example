FLASK_ENV=development
SECRET_KEY=change-me-to-random-secret-key
BASE_URL=http://localhost:5000

# Database
DATABASE_URL=mysql+pymysql://setu_user:CHANGE_PASSWORD@localhost:3306/setu?charset=utf8mb4

# OTP
OTP_PEPPER=change-me-to-long-random-string

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
MAIL_FROM_NAME=SETU

# Gemini API (optional, P1)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Features
ENABLE_SIMULATION=true

# Safety Engine Config
CORRIDOR_RADIUS_M=500
PERSIST_SECONDS=20
PERSIST_PINGS=3
MAX_ACCURACY_M=100
SIGNAL_LOSS_SECONDS=90
MAX_SPEED_KMH=120

# Service Area
SERVICE_AREA_BBOX=12.80,77.40,13.20,77.80

# Session
SESSION_IDLE_MINUTES=30
